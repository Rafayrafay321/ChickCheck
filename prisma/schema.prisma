// Dukaan POS — Local SQLite Schema (Source of Truth)
// All data lives here first. Cloud is a backup/read layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}



// ─── OWNER / AUTH ────────────────────────────────────────────────
model Owner {
  id        String   @id @default(cuid())
  name      String
  shopName  String
  phone     String?
  password  String   // bcrypt hashed
  createdAt DateTime @default(now())

  @@map("owner")
}

// ─── DAILY RATE ──────────────────────────────────────────────────
model DailyRate {
  id              String   @id @default(cuid())
  date            DateTime @unique
  farmRate        Float
  supplierPremium Float    @default(4)
  supplyRate      Float    // farmRate + supplierPremium
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("daily_rates")
}

// ─── SUPPLIER PURCHASES (ZINDA MURGI) ───────────────────────────
model SupplierPurchase {
  id           String   @id @default(cuid())
  supplierName String
  grossWeight  Float
  dudWeight    Float    @default(0) // Mortality / deduction in kg
  netWeight    Float    // grossWeight - dudWeight
  ratePerKg    Float    // purchasing rate (supplyRate)
  totalAmount  Float    // netWeight * ratePerKg
  cashPaid     Float    @default(0)
  purchaseDate DateTime @default(now())
  createdAt    DateTime @default(now())

  @@map("supplier_purchases")
}

// ─── CUSTOMERS ───────────────────────────────────────────────────
model Customer {
  id          String   @id @default(cuid())
  name        String
  type        String   // 'RESTAURANT' | 'RETAIL' | 'WHOLESALE'
  phone       String?
  address     String?
  totalUdhaar Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  invoices    Invoice[]
  payments    Payment[]
  multipliers CustomerMultiplier[]

  @@map("customers")
}

// ─── PRODUCTS ────────────────────────────────────────────────────
model Product {
  id                String   @id @default(cuid())
  name              String
  nameUrdu          String?
  unit              String   @default("kg") // 'kg' | 'piece'
  pricingType       String   @default("MULTIPLIER") // 'MULTIPLIER' | 'FIXED'
  defaultMultiplier Float?   // e.g. 1.5 for Meat, 2.0 for Boneless, 1.6 for Tikka
  pricePerUnit      Float    @default(0) // Fixed daily price if pricingType === 'FIXED'
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderItems   OrderItem[]
  stockEntries StockEntry[]
  multipliers  CustomerMultiplier[]
  stockAudits  DailyStockAudit[]

  @@map("products")
}

// ─── CUSTOMER MULTIPLIER OVERRIDES ──────────────────────────────
model CustomerMultiplier {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  multiplier Float    // e.g. 1.45 for Customer X on Meat

  @@unique([customerId, productId])
  @@map("customer_multipliers")
}

// ─── EXPENSES ────────────────────────────────────────────────────
model Expense {
  id        String   @id @default(cuid())
  category  String   // 'PETROL' | 'BAGS' | 'BIKE' | 'PUNCHER' | 'POLICE' | 'LUNCH' | 'WAGES' | 'OTHER'
  amount    Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("expenses")
}

// ─── DAILY STOCK AUDIT ───────────────────────────────────────────
model DailyStockAudit {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  auditDate DateTime
  openingKg Float    @default(0)
  inKg      Float    @default(0)
  outKg     Float    @default(0)
  closingKg Float    @default(0)
  createdAt DateTime @default(now())

  @@map("daily_stock_audits")
}

// ─── STOCK ENTRIES ───────────────────────────────────────────────
model StockEntry {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // 'IN' | 'OUT'
  quantity  Float
  note      String?
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("stock_entries")
}

// ─── ORDERS ──────────────────────────────────────────────────────
model Order {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  status      String    @default("PENDING") // 'PENDING' | 'DELIVERED' | 'CANCELLED'
  totalAmount Float     @default(0)
  note        String?
  orderDate   DateTime  @default(now())
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items   OrderItem[]
  invoice Invoice?

  @@map("orders")
}

// ─── ORDER ITEMS ─────────────────────────────────────────────────
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float    // price at time of order — calculated via multiplier * supplyRate
  total     Float    // quantity * unitPrice
  createdAt DateTime @default(now())

  @@map("order_items")
}

// ─── INVOICES ────────────────────────────────────────────────────
model Invoice {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  totalAmount Float
  paidAmount  Float     @default(0)
  status      String    @default("UNPAID") // 'UNPAID' | 'PARTIAL' | 'PAID'
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@map("invoices")
}

// ─── PAYMENTS ────────────────────────────────────────────────────
model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  method     String   @default("CASH") // 'CASH' | 'JAZZCASH' | 'EASYPAISA' | 'BANK'
  note       String?
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("payments")
}

// ─── END OF DAY ──────────────────────────────────────────────────
model EndOfDay {
  id               String   @id @default(cuid())
  reportDate       DateTime @unique // one per day
  farmRate         Float?
  supplyRate       Float?
  totalSales       Float    @default(0)
  totalPurchases   Float    @default(0)
  totalExpenses    Float    @default(0)
  grossProfit      Float    @default(0)
  netProfit        Float    @default(0)
  retailCashDrawer Float    @default(0)
  discrepancy      Float    @default(0)
  note             String?
  createdAt        DateTime @default(now())

  @@map("end_of_day")
}

// ─── SYNC LOG ────────────────────────────────────────────────────
model SyncLog {
  id            String   @id @default(cuid())
  syncedAt      DateTime @default(now())
  recordsPushed Int?
  status        String   // 'SUCCESS' | 'FAILED'
  error         String?

  @@map("sync_log")
}